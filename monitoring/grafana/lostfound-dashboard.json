{
  "title": "Campus Lost & Found",
  "uid": "lostfound",
  "tags": ["lostfound", "capstone"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    { "id": 1, "type": "stat", "title": "Requests / s", "gridPos": {"x":0,"y":0,"w":6,"h":4},
      "targets": [{ "expr": "sum(rate(http_requests_total{namespace=\"lostfound\"}[1m]))", "refId": "A" }],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}} },
    { "id": 2, "type": "stat", "title": "5xx ratio", "gridPos": {"x":6,"y":0,"w":6,"h":4},
      "targets": [{ "expr": "sum(rate(http_requests_total{namespace=\"lostfound\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"lostfound\"}[5m])),0.001)", "refId": "A" }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":0.05}]}}} },
    { "id": 3, "type": "stat", "title": "Database up", "gridPos": {"x":12,"y":0,"w":6,"h":4},
      "targets": [{ "expr": "min(lostfound_db_up{namespace=\"lostfound\"})", "refId": "A" }],
      "fieldConfig": {"defaults": {"mappings": [{"type":"value","options":{"0":{"text":"DOWN","color":"red"},"1":{"text":"UP","color":"green"}}}]}} },
    { "id": 4, "type": "stat", "title": "Backend replicas (ready)", "gridPos": {"x":18,"y":0,"w":6,"h":4},
      "targets": [{ "expr": "sum(kube_deployment_status_replicas_ready{namespace=\"lostfound\",deployment=\"lostfound-backend\"})", "refId": "A" }] },
    { "id": 5, "type": "timeseries", "title": "Requests / s by route and status", "gridPos": {"x":0,"y":4,"w":12,"h":8},
      "targets": [{ "expr": "sum by (path, status) (rate(http_requests_total{namespace=\"lostfound\"}[1m]))", "legendFormat": "{{path}} {{status}}", "refId": "A" }],
      "fieldConfig": {"defaults": {"unit": "reqps"}} },
    { "id": 6, "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": {"x":12,"y":4,"w":12,"h":8},
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"lostfound\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"lostfound\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"lostfound\"}[5m])))", "legendFormat": "p99", "refId": "C" }],
      "fieldConfig": {"defaults": {"unit": "s"}} },
    { "id": 7, "type": "timeseries", "title": "Backend CPU (cores) vs HPA replicas", "gridPos": {"x":0,"y":12,"w":12,"h":8},
      "targets": [
        { "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"lostfound\",container=\"api\"}[2m]))", "legendFormat": "{{pod}}", "refId": "A" },
        { "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"lostfound\"}", "legendFormat": "hpa replicas", "refId": "B" }] },
    { "id": 8, "type": "timeseries", "title": "Container restarts (lostfound ns)", "gridPos": {"x":12,"y":12,"w":12,"h":8},
      "targets": [{ "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"lostfound\"}[10m]))", "legendFormat": "{{pod}}", "refId": "A" }] },
    { "id": 9, "type": "timeseries", "title": "Open items (business metric)", "gridPos": {"x":0,"y":20,"w":12,"h":6},
      "targets": [{ "expr": "max(lostfound_items_open{namespace=\"lostfound\"})", "legendFormat": "open items", "refId": "A" }] },
    { "id": 10, "type": "timeseries", "title": "Backend memory (working set)", "gridPos": {"x":12,"y":20,"w":12,"h":6},
      "targets": [{ "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"lostfound\",container=\"api\"})", "legendFormat": "{{pod}}", "refId": "A" }],
      "fieldConfig": {"defaults": {"unit": "bytes"}} }
  ]
}
